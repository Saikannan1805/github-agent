# ── Groq (free) ──────────────────────────────────────────────────────────────
# Get your key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Supabase (free tier) ──────────────────────────────────────────────────────
# Project Settings > API in your Supabase dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ── Embeddings ───────────────────────────────────────────────────────────────
# Default "local" runs all-MiniLM-L6-v2 in-process via fastembed (no key or credits).
# Set to "hf" to use the HuggingFace Inference API instead (needs HUGGINGFACE_API_KEY).
# EMBEDDINGS_BACKEND=local
# Create a token at https://huggingface.co/settings/tokens (read access is enough)
HUGGINGFACE_API_KEY=hf_your_token_here

# ── GitHub (optional — increases rate limit from 60 to 5000 req/hr) ──────────
# Create at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=your_github_token_here

# ── Frontend (set in frontend/.env.local) ────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
